{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "browsers": ["last 2 versions"]
      },
      "useBuiltIns": "usage",
      "corejs": 3
    }]
  ],
  "env": {
    "test": {
      "plugins": [
        "@babel/plugin-transform-modules-commonjs",
        "@babel/plugin-transform-object-rest-spread"
      ]
    },
    "build": {
      "plugins": [
        "@babel/plugin-transform-object-rest-spread",
        "lodash"
      ]
    }
  }
}
